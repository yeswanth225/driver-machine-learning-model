# Environment Configuration for Intelligent Driver Activity Monitoring & Safety Agent

# Application Settings
APP_NAME="Intelligent Driver Activity Monitoring & Safety Agent"
APP_ENV="development"
DEBUG=True
API_V1_PREFIX="/api/v1"
HOST="0.0.0.0"
PORT=8000

# Security & CORS
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# Database (SQLite default for initial development)
DATABASE_URL="sqlite+aiosqlite:///./driver_monitoring.db"

# ML & Inference Settings
MODEL_PATH="ml/saved_models/driver_activity_model.joblib"
INFERENCE_BATCH_SIZE=32
DEVICE="cpu" # "cpu" or "cuda"

# Real-Time & WebSockets
WS_MESSAGE_INTERVAL_MS=100
ALERT_CONFIDENCE_THRESHOLD=0.80
