{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/**/*.py": {
      "includeFiles": "{backend/**,ml/**,models/experiments/dataset_b/**,models/experiments/dataset_c/**,public/**}"
    },
    "main.py": {
      "includeFiles": "{backend/**,ml/**,models/experiments/dataset_b/**,models/experiments/dataset_c/**,public/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/docs",
      "destination": "/api/index"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/|docs|openapi.json|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
