access_token
.kaggle/

# Data & Model Artifacts
# Note: Raw datasets in dataset/raw/ can be tracked for complete standalone portability
# Ignore temporary zip archives, intermediate checkpoints, and large model binaries
*.zip
*.rar
dataset/raw/**/__MACOSX/
dataset/interim/
!dataset/raw/
!dataset/.gitkeep

# Processed evaluation datasets and metadata required for tests
!dataset/processed/
!dataset/processed/*.json
!dataset/processed/*.csv

# Saved model artifacts and configs required for inference & tests
!ml/saved_models/
!ml/saved_models/.gitkeep
!ml/saved_models/*.json
!ml/saved_models/*.joblib
*.h5
*.pkl
*.pt
*.pth
*.onnx

# Jupyter Notebook checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# Database
*.sqlite
*.sqlite3
*.db

