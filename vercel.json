{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/**/*.py": {
      "excludeFiles": "{dataset/raw/**,dataset/experiments/**,dataset/derived/**,dataset/metadata/**,frontend/**,notebooks/**,reports/**,scripts/**,tests/**,mobile/**,docs/**}"
    },
    "api/index.py": {
      "excludeFiles": "{dataset/raw/**,dataset/experiments/**,dataset/derived/**,dataset/metadata/**,frontend/**,notebooks/**,reports/**,scripts/**,tests/**,mobile/**,docs/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
